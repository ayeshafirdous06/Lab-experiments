
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


head = None


def insert_begin():
    global head

    x = int(input("Enter element: "))
    new_node = Node(x)

    if head is None:
        head = new_node
        new_node.next = head
    else:
        temp = head

        while temp.next != head:
            temp = temp.next

        new_node.next = head
        temp.next = new_node
        head = new_node

    print("Node inserted")


def insert_end():
    global head

    x = int(input("Enter element: "))
    new_node = Node(x)

    if head is None:
        head = new_node
        new_node.next = head
    else:
        temp = head

        while temp.next != head:
            temp = temp.next

        temp.next = new_node
        new_node.next = head

    print("Node inserted")


def insert_pos():
    global head

    x = int(input("Enter element: "))
    pos = int(input("Enter position: "))

    if pos < 1:
        print("Invalid Position")
        return

    new_node = Node(x)

    if pos == 1:
        if head is None:
            head = new_node
            new_node.next = head
        else:
            temp = head

            while temp.next != head:
                temp = temp.next

            new_node.next = head
            temp.next = new_node
            head = new_node

        print("Node inserted")
        return

    if head is None:
        print("Invalid Position")
        return

    temp = head

    for i in range(pos - 2):
        temp = temp.next

        if temp == head:
            print("Invalid Position")
            return

    new_node.next = temp.next
    temp.next = new_node

    print("Node inserted")


def delete_begin():
    global head

    if head is None:
        print("List is Empty")
        return

    if head.next == head:
        print("Deleted element:", head.data)
        head = None
        return

    temp = head

    while temp.next != head:
        temp = temp.next

    print("Deleted element:", head.data)

    head = head.next
    temp.next = head


def delete_end():
    global head

    if head is None:
        print("List is Empty")
        return

    if head.next == head:
        print("Deleted element:", head.data)
        head = None
        return

    temp = head

    while temp.next.next != head:
        temp = temp.next

    print("Deleted element:", temp.next.data)

    temp.next = head


def delete_pos():
    global head

    pos = int(input("Enter position: "))

    if pos < 1 or head is None:
        print("Invalid Position or Empty List")
        return

    if pos == 1:
        delete_begin()
        return

    temp = head

    for i in range(pos - 2):
        temp = temp.next

        if temp == head:
            print("Invalid Position")
            return

    if temp.next == head:
        print("Invalid Position")
        return

    print("Deleted element:", temp.next.data)
    temp.next = temp.next.next


def search():
    if head is None:
        print("List is Empty")
        return

    x = int(input("Enter element to search: "))
    temp = head
    pos = 1

    while True:
        if temp.data == x:
            print("Element found at position:", pos)
            return

        temp = temp.next
        pos += 1

        if temp == head:
            break

    print("Element not found")


def display():
    if head is None:
        print("List is Empty")
        return

    temp = head

    print("Circular Linked List:", end=" ")

    while True:
        print(temp.data, end=" -> ")
        temp = temp.next

        if temp == head:
            break

    print("(Back to Head)")


while True:
    print("\n--- CIRCULAR LINKED LIST ---")
    print("1. INSERT BEGINNING")
    print("2. INSERT END")
    print("3. INSERT POSITION")
    print("4. DELETE BEGINNING")
    print("5. DELETE END")
    print("6. DELETE POSITION")
    print("7. SEARCH")
    print("8. DISPLAY")
    print("9. EXIT")

    ch = int(input("Enter choice: "))

    if ch == 1:
        insert_begin()

    elif ch == 2:
        insert_end()

    elif ch == 3:
        insert_pos()

    elif ch == 4:
        delete_begin()

    elif ch == 5:
        delete_end()

    elif ch == 6:
        delete_pos()

    elif ch == 7:
        search()

    elif ch == 8:
        display()

    elif ch == 9:
        break

    else:
        print("Invalid Choice")
