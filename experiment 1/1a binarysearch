a = list(map(int, input("Enter elements: ").split()))
key = int(input("Enter element to search: "))

low = 0
high = len(a) - 1
found = False

while low <= high:
    mid = (low + high) // 2

    if a[mid] == key:
        print("Element found at position", mid + 1)
        found = True
        break
    elif key < a[mid]:
        high = mid - 1
    else:
        low = mid + 1

if not found:
    print("Element not found")
