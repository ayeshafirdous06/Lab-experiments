
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

top = None

def push():
    global top

    x = int(input("Enter element: "))
    new_node = Node(x)

    new_node.next = top
    top = new_node

    print("Element inserted")

def pop():
    global top

    if top is None:
        print("Stack Underflow")
    else:
        print("Deleted element:", top.data)
        top = top.next

def display():
    if top is None:
        print("Stack is Empty")
    else:
        temp = top

        print("Stack elements:", end=" ")

        while temp:
            print(temp.data, end=" ")
            temp = temp.next

        print()


while True:
    print("\n1. PUSH")
    print("2. POP")
    print("3. DISPLAY")
    print("4. EXIT")

    ch = int(input("Enter choice: "))

    if ch == 1:
        push()
    elif ch == 2:
        pop()
    elif ch == 3:
        display()
    elif ch == 4:
        break
    else:
        print("Invalid Choice")
